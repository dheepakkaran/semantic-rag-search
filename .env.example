# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Providers to try, in order. When one refuses — an exhausted daily quota,
# most likely — the same prompt goes to the next, so the fallback answer is
# grounded in exactly the same retrieved passages.
LLM_PROVIDER_CHAIN=gemini,openai

# Free key from https://aistudio.google.com
# The free tier allows 20 generations a day, which is why fallback exists.
GEMINI_API_KEY=

# https://platform.openai.com/api-keys — used when Gemini runs out.
OPENAI_API_KEY=

# Optional model overrides.
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini

# Set instead of LLM_PROVIDER_CHAIN to pin one provider with no fallback.
# LLM_PROVIDER=gemini

# Port the web container publishes. 80 on a server.
# WEB_PORT=8080
